{
  "expo": {
    "name": "PantryPulse",
    "slug": "pantry-pulse",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pantrypulse",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.skullrunner.pantrypulse",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "PantryPulse uses your camera to scan grocery barcodes and capture store receipts for automatic inventory tracking.",
        "NSPhotoLibraryUsageDescription": "PantryPulse accesses your photo library so you can import grocery receipt images for OCR scanning."
      }
    },
    "android": {
      "package": "com.pantrypulse.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#1B4332",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "./plugins/withMlKitOcr.js",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow PantryPulse to scan grocery barcodes and receipts."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow PantryPulse to import receipt photos from your library."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1B4332"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F7F6F2"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "8855391a-5b56-4a74-8e46-6d447b2b3d18"
      }
    },
    "owner": "skullrunner"
  }
}
